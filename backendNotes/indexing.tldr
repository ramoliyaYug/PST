										{
											"type": "bold"
										}
									],
									"text": "Mongoose"
								},
								{
									"type": "text",
									"text": " is an "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Object Data"
