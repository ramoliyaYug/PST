								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										},
										{
											"type": "code"
										}
									],
									"text": "mongosh"
								},
								{
									"type": "text",
									"text": " is the new "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "MongoDB sh"
								},
								{
									"type": "text",
									"text": "ell, an interactive command-line interface. It's used to connect to a running "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "code"
										}
									],
									"text": "mongod"
								},
								{
									"type": "text",
									"text": " instance and perform administrative tasks, execute queries, and manipulate your data. Think of it as the terminal for your database"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "b022Bz",
			"typeName": "shape"
		},
		{
			"x": 1871.0427778742583,
